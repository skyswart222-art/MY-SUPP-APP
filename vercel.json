{
  "functions": { "api/claude.js": { "maxDuration": 120 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(app.js|auth.js|auth.css|config.js|index.html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
